PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL / Prisma Postgres)
DATABASE_URL=postgresql://nextmsg_user:nextmsg_password@localhost:5432/nextmsg_db
# PRISMA_DATABASE_URL=prisma+postgres://...

# Redis & Cache
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_SECRET=supersecret_corporate_messenger_key_change_in_production
JWT_REFRESH_SECRET=supersecret_corporate_refresh_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Asaas Payment Gateway
ASAAS_API_KEY=$aact_example_key_change_in_production
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_TOKEN=corpchat_webhook_secret_token

# Cloudflare R2 / AWS S3 (Pro Store & Forward)
S3_ENDPOINT=https://example.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=example_access_key
S3_SECRET_ACCESS_KEY=example_secret_key
S3_BUCKET_NAME=corpchat-files
S3_REGION=auto

# Clicksign Electronic Signature
CLICKSIGN_API_KEY=clicksign_test_api_key
CLICKSIGN_ENVIRONMENT=sandbox
CLICKSIGN_WEBHOOK_HMAC_SECRET=clicksign_webhook_secret

# CORS
CORS_ORIGIN=http://localhost:3000
