# ==============================================================================
# NextMsg - Variáveis de Ambiente (Environment Variables)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS (OBRIGATÓRIO PARA A API FUNCIONAR)
# Provedor PostgreSQL gerenciado na nuvem (Ex: Prisma Postgres, Neon.tech, Supabase)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
POSTGRES_URL=postgresql://user:password@host:5432/database?sslmode=require
PRISMA_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DATABASE_SSL=true

# ------------------------------------------------------------------------------
# 2. AUTENTICAÇÃO E SEGURANÇA (OBRIGATÓRIO)
# Chave secreta forte para assinar e validar tokens JWT
# ------------------------------------------------------------------------------
JWT_SECRET=chave_secreta_super_forte_para_producao_substitua_aqui

# ------------------------------------------------------------------------------
# 3. URL DA APLICAÇÃO
# URL pública do projeto na Vercel (para links de convite e redirecionamentos)
# ------------------------------------------------------------------------------
APP_URL=https://next-msg-three.vercel.app

# ------------------------------------------------------------------------------
# 4. REDIS (RECOMENDADO PARA STATUS ONLINE E FILAS DE EXPIRAÇÃO)
# Instância Redis na nuvem (Ex: Upstash Redis - integração direta na Vercel)
# ------------------------------------------------------------------------------
REDIS_URL=redis://default:token@host:6379

# ------------------------------------------------------------------------------
# 5. STORAGE S3 / CLOUDFLARE R2 (UPLOADS DE ARQUIVOS NOS PLANOS PRO/ENTERPRISE)
# Se não configurado, arquivos em memória (Plano Free) continuam funcionando
# ------------------------------------------------------------------------------
S3_BUCKET=corpchat-attachments
S3_REGION=auto
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=seu_access_key_id
S3_SECRET_ACCESS_KEY=seu_secret_access_key
S3_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------------------
# 6. ASSINATURA ELETRÔNICA (CLICKSIGN - OPCIONAL)
# ------------------------------------------------------------------------------
CLICKSIGN_API_KEY=mock-clicksign-api-key
CLICKSIGN_API_URL=https://sandbox.clicksign.com/api/v1
CLICKSIGN_WEBHOOK_SECRET=clicksign-webhook-secret

# ------------------------------------------------------------------------------
# 7. FATURAMENTO E COBRANÇAS (ASAAS - OPCIONAL)
# ------------------------------------------------------------------------------
ASAAS_API_KEY=mock-asaas-api-key
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_SECRET=asaas-webhook-secret

# ------------------------------------------------------------------------------
# 8. LOGS
# ------------------------------------------------------------------------------
LOG_LEVEL=info
